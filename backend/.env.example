# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="allStay Hotel API"
ENVIRONMENT=development
DEBUG=false

# ── Security (generate with: openssl rand -hex 32) ────────────────────────────
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@localhost:5432/hotel_system
# Optional: set these to route through PgBouncer once it's running.
# Leave blank to use DATABASE_URL directly (safe for local dev).
DATABASE_URL_PRIMARY=
DATABASE_URL_REPLICA=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:REPLACE_PASSWORD@localhost:6379/0

# ── CORS (comma-separated allowed frontend origins) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your@email.com
EMAIL_FROM_NAME="allStay"

# ── Docker Compose vars ───────────────────────────────────────────────────────
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=hotel_system
REDIS_PASSWORD=REPLACE_PASSWORD
PGADMIN_EMAIL=admin@hotel.local
PGADMIN_PASSWORD=REPLACE_PASSWORD
# Required for streaming replication (generate with: openssl rand -hex 16)
REPLICATION_PASSWORD=REPLACE_PASSWORD
# Traefik — set to your real domain in production
DOMAIN=localhost
ACME_EMAIL=your@email.com
# Meilisearch master key (generate with: openssl rand -hex 16)
MEILISEARCH_KEY=REPLACE_PASSWORD

# ── Frontend URL (used in email verification / password reset links) ─────────
FRONTEND_URL=https://yourdomain.com

# ── MinIO object storage (Phase 3) ───────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=hotel-avatars

# ── Jaeger tracing (Phase 3 — leave blank to disable) ────────────────────────
JAEGER_ENDPOINT=http://jaeger:4317

# ── Cloudflare (Phase 4) ──────────────────────────────────────────────────────
# Required only when using letsencrypt-dns resolver (domain proxied through Cloudflare).
# Create a token at dash.cloudflare.com → My Profile → API Tokens with
# Zone:DNS:Edit permission scoped to your domain.
CF_API_TOKEN=REPLACE_WITH_CF_TOKEN
